{
  "schemaVersion": 1,
  "id": "symmetry",
  "version": "${version}",
  "name": "Symmetry",
  "description": "A client-side mod for visualizing symmetrical builds in real time using Litematica.",
  "authors": [
    "DevReaper0"
  ],
  "contact": {
    "issues": "https://github.com/DevReaper0/symmetry/issues",
    "sources": "https://github.com/DevReaper0/symmetry"
  },
  "license": "MIT",
  "icon": "assets/symmetry/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "xyz.devreaper0.symmetry.Symmetry"
    ]
  },
  "mixins": [
    "symmetry.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_versions}",
    "malilib": "~${malilib_version}",
    "litematica": "~${litematica_version}"
  },
  "custom": {
    "modmenu": {
      "parent": "litematica"
    }
  }
}
